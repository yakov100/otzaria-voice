#!/bin/sh
# The LaunchAgent starts the service at every login; start it now as well for
# the user who is logged in, so no logout is needed.
plist="/Library/LaunchAgents/org.otzaria.voice.plist"
chown root:wheel "$plist" && chmod 644 "$plist"
user="$(stat -f %Su /dev/console 2>/dev/null)"
if [ -n "$user" ] && [ "$user" != "root" ]; then
  uid="$(id -u "$user")"
  launchctl bootstrap "gui/$uid" "$plist" 2>/dev/null || launchctl kickstart -k "gui/$uid/org.otzaria.voice" 2>/dev/null || true
fi
exit 0
