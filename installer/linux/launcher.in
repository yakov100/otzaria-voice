#!/bin/sh
# Starts the Otzaria voice service. Generated by installer/linux/package.sh.
# The service finds ONNX Runtime next to itself and the voice pack in its
# standard places (docs/platforms.md); LD_LIBRARY_PATH is only a fallback.
LIBDIR="@LIBDIR@"
export LD_LIBRARY_PATH="$LIBDIR${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
exec "$LIBDIR/otzaria-voice" "$@"
