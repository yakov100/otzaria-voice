#!/bin/sh
# Starts the Otzaria voice service with its bundled ONNX Runtime.
# Generated by installer/linux/package.sh.
LIBDIR="@LIBDIR@"
PACKDIR="@PACKDIR@"
export LD_LIBRARY_PATH="$LIBDIR${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
# A package built with the voice pack carries it in PACKDIR; use it unless the
# user points the service elsewhere.
if [ -z "${OTZARIA_VOICE_PACK_DIR:-}" ] && [ -n "$PACKDIR" ] && [ -f "$PACKDIR/version.txt" ]; then
  export OTZARIA_VOICE_PACK_DIR="$PACKDIR"
fi
exec "$LIBDIR/otzaria-voice" "$@"
