# Scripts and templates that run on Linux/macOS must keep LF line endings,
# even when the repository is checked out on Windows.
*.sh       text eol=lf
*.in       text eol=lf
*.desktop  text eol=lf
*.plist    text eol=lf
*.yml      text eol=lf
*.c        text eol=lf
installer/macos/scripts/*  text eol=lf

# Windows batch files need CRLF.
*.cmd      text eol=crlf
*.bat      text eol=crlf

# Binary assets.
*.png      binary
*.zip      binary
*.onnx     binary
