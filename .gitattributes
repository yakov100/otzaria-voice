# Scripts and templates that run on Linux/macOS must keep LF line endings,
# even when the repository is checked out on Windows.
*.sh       text eol=lf
*.in       text eol=lf
*.desktop  text eol=lf
*.plist    text eol=lf
*.yml      text eol=lf
*.c        text eol=lf
installer/macos/scripts/*  text eol=lf

# Windows batch files need CRLF. They are stored with CRLF and never converted
# (-text): an export (GitHub's source tarball, git archive) must hold the same
# bytes as the commit, and the Otzaria plugin store rejects a source whose
# tarball differs from the commit's tree. "eol=crlf" converted them on export.
*.cmd      -text
*.bat      -text

# Binary assets.
*.png      binary
*.zip      binary
*.onnx     binary
