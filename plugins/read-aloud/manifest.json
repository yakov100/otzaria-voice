{
  "schemaVersion": 1,
  "id": "org.otzaria.read-aloud",
  "name": "הקראה קולית",
  "version": "1.3.6",
  "description": "מקריא בקול את הספר הפתוח ומדגיש את הנקרא, ושומר פרק או קטע מסומן כקובץ MP3, בקול של Windows או בקול מוקלט. עובד בלי אינטרנט.",
  "author": "yakov100",
  "homepage": "https://github.com/yakov100/otzaria-voice",
  "entrypoint": "main.js",
  "headless": true,
  "icon": "icon/icon.png",
  "minAppVersion": "0.9.98",
  "sdkVersion": "1.x",
  "stability": "stable",
  "permissions": [
    "app.startup_contributions",
    "app.run_on_startup",
    "app.shortcuts",
    "reader.open",
    "reader.toolbar",
    "reader.context_menu",
    "reader.highlight",
    "library.content.read",
    "network.localhost",
    "fs.folder_access",
    "app.open_url",
    "network.access"
  ],
  "network": {
    "enabled": true,
    "allowlist": [
      "http://127.0.0.1:47811",
      "https://github.com/yakov100/otzaria-voice/releases/latest/download/otzaria-voice-windows-x64-without-models.exe",
      "https://github.com/yakov100/otzaria-voice/releases/download"
    ]
  },
  "contributes": {
    "startup": {
      "toolbarItems": [
        {
          "id": "tts-main",
          "type": "split",
          "title": "הקראה קולית",
          "icon": "speaker_2_24_regular",
          "contexts": [
            "reader-text"
          ],
          "children": [
            {
              "id": "play",
              "title": "הקרא / השהה",
              "icon": "play_24_regular"
            },
            {
              "id": "stop",
              "title": "עצור והתחל מחדש",
              "icon": "stop_24_regular"
            },
            {
              "id": "rate-slow",
              "title": "מהירות: איטית"
            },
            {
              "id": "rate-normal",
              "title": "מהירות: רגילה"
            },
            {
              "id": "rate-fast",
              "title": "מהירות: מהירה"
            },
            {
              "id": "rate-faster",
              "title": "מהירות: מהירה מאוד"
            }
          ]
        },
        {
          "id": "tts-voice",
          "type": "menu",
          "title": "קול ושמירה כ-MP3",
          "icon": "fluent:person_24_regular",
          "contexts": [
            "reader-text"
          ],
          "children": [
            {
              "id": "voice-system",
              "title": "אסף (של Windows)"
            },
            {
              "id": "voice-chaim",
              "title": "חיים (מוקלט, לשמירה בלבד)"
            },
            {
              "id": "save-chapter",
              "title": "שמור את הפרק כ-MP3",
              "icon": "fluent:arrow_download_24_regular"
            },
            {
              "id": "choose-folder",
              "title": "בחר תיקייה לשמירת MP3",
              "icon": "fluent:folder_open_24_regular"
            },
            {
              "id": "cancel-export",
              "title": "בטל את שמירת ה-MP3",
              "icon": "fluent:dismiss_circle_24_regular"
            },
            {
              "id": "remove-voice-model",
              "title": "הסר את הקול המוקלט מהמחשב",
              "icon": "fluent:delete_24_regular"
            }
          ]
        }
      ],
      "contextMenuItems": [
        {
          "id": "tts-read-selection",
          "label": "הקרא בקול",
          "icon": "speaker_2_24_regular",
          "contexts": [
            "reader-selection",
            "reader-page-shape-selection"
          ]
        },
        {
          "id": "tts-save-selection",
          "label": "שמור כ-MP3",
          "icon": "fluent:arrow_download_24_regular",
          "contexts": [
            "reader-selection",
            "reader-page-shape-selection"
          ]
        }
      ],
      "shortcuts": [
        {
          "id": "tts-toggle",
          "label": "הקראה קולית: הפעל / השהה",
          "key": "ctrl+alt+r",
          "command": "toggle"
        },
        {
          "id": "tts-stop",
          "label": "הקראה קולית: עצור",
          "command": "stop"
        }
      ]
    }
  }
}
